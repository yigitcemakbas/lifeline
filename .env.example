# Free Groq API key (https://console.groq.com). Required: the dashboard runs the AI live.
GROQ_API_KEY=
# Optional model overrides (chat models must support JSON schema output on Groq)
LIFELINE_INTERPRET_MODEL=openai/gpt-oss-20b
LIFELINE_SYNTHESIS_MODEL=openai/gpt-oss-120b
LIFELINE_STT_MODEL=whisper-large-v3-turbo
