        "zone_hint": "Z-UPPER",
        "delivery_status": "store-and-forward via passing vehicle, ~40 min delay",
        "text": "This is the school teacher in Yaylakoy. Families gathered in the school yard, 60-70 people, it will be cold tonight, we need blankets. Some elderly are not accounted for."
      }
    },
    {
      "t": 8,
      "kind": "comm",
      "channel": "cellular",
      "payload": {
        "id": "C-1",
